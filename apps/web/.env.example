DATABASE_URL=postgresql://postgres@localhost:5432/ita
SESSION_SECRET=change-me-to-32+-random-bytes

# --- Hosting (Vercel / any serverless host) ---
# Use the database provider's POOLED connection string in DATABASE_URL (add ?sslmode=require).
# Private file storage (S3, Cloudflare R2, Supabase Storage...). Leave empty to use local disk in development.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=            # for R2 / Supabase / MinIO
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# CRON_SECRET=            # Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
# PUBLIC_URL=https://your-domain
# First deploy only: creates the first super admin when the database is empty (the build script reads these, then they can be removed).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=         # 10+ characters, letters and digits
