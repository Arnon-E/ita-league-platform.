{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "esnext"], "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true, "noEmit": true, "esModuleInterop": true,
    "jsx": "preserve", "incremental": true, "resolveJsonModule": true, "isolatedModules": true,
    "plugins": [{ "name": "next" }], "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "src", "test", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
