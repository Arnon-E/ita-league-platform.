{
  "expo": {
    "name": "ITA",
    "slug": "ita-league",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "il.org.tennis.league"
    },
    "android": {
      "package": "il.org.tennis.league",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-foreground.png",
        "backgroundColor": "#1D4FE0"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "expo-font"
    ],
    "extra": {
      "apiUrl": "https://ita-league-platform-jpgi.vercel.app"
    },
    "newArchEnabled": true,
    "icon": "./assets/icon/icon.png"
  }
}
